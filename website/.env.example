# Copy to .env (gitignored). Server-side only; never expose to the browser.
N8N_AGENT_WEBHOOK_URL=https://n8n.example.com/webhook/ht-global/pcb-quote-agent
N8N_AGENT_SECRET=replace-with-a-random-hex-string

# Optional: call Salesforce as the n8n integration user (JWT bearer) instead of the sf CLI session.
# Needed so the quote agent can write into conversations (records are owned by the creator).
SF_AUTH=jwt
# SF_JWT_DIR=../.secrets/ht-global-n8n
