# Copy to /home/ubuntu/ht-global/web.env on the VM (chmod 600). Never commit real values.
# SF_AUTH, SF_JWT_DIR, TRUST_PROXY and PORT are set by docker-compose.yml.

# n8n quote agent webhook (called after an RFQ or a customer message)
N8N_AGENT_WEBHOOK_URL=https://n8n.example.com/webhook/ht-global/pcb-quote-agent
N8N_AGENT_SECRET=replace-with-a-random-hex-string

# Rate limits per client IP (defaults shown). Windows are in seconds.
RATE_POST_MAX=5
RATE_POST_WINDOW_SEC=600
RATE_PATCH_MAX=30
RATE_PATCH_WINDOW_SEC=600
RATE_MESSAGES_MAX=120
RATE_MESSAGES_WINDOW_SEC=60
RATE_MAX_TRACKED_IPS=10000

# File uploads (POST /api/quote/files): uploads per client IP per window, hard size cap, and how many may be in
# flight at once. Each in-flight upload holds the whole file in memory (about 3x its size while it is sent to
# Salesforce), so keep UPLOAD_MAX_CONCURRENT * 75 MB well under the container's mem_limit (384m).
RATE_UPLOAD_MAX=10
RATE_UPLOAD_WINDOW_SEC=600
UPLOAD_MAX_BYTES=26214400
UPLOAD_MAX_CONCURRENT=2
# An upload body that sends no data for this many seconds is aborted with 408 (frees the slot).
UPLOAD_IDLE_TIMEOUT_SEC=30
