# Site block for the HT Global demo website.
#
# Append it to /opt/platform/Caddyfile on the OCI VM (never overwrite the file):
#   sudo cp /opt/platform/Caddyfile /opt/platform/Caddyfile.bak.$(date +%Y%m%d-%H%M%S)
#   cat deploy/Caddyfile.snippet | sudo tee -a /opt/platform/Caddyfile >/dev/null
#   docker exec platform-caddy-1 caddy validate --config /etc/caddy/Caddyfile
#   docker exec platform-caddy-1 caddy reload   --config /etc/caddy/Caddyfile
# If validate fails, restore the backup and do not reload.
# Prerequisites: DNS A record htglobal.vantegrateos.com -> <vm-ip>, and the
# ht-global-web container running on the vantegrate_default network.
htglobal.vantegrateos.com {
	# Uploads: Caddy sets no request body limit by default (do not add request_body max_size below 25MB).
	# The app enforces 25 MB per file and answers 413 itself.
	encode zstd gzip
	reverse_proxy ht-global-web:4173
}
