<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Quote Conversation (Sellium)</masterLabel>
    <description>Shows the Sellium conversation thread linked to this quote, with a link to open it in the Sellium Console.</description>
    <targets>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>Quote</object>
            </objects>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
